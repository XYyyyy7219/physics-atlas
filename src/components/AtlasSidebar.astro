---
import CourseNavigation from './CourseNavigation.astro';
import { Icon } from '@astrojs/starlight/components';
---
<div class="atlas-sidebar-links"><CourseNavigation /></div>
<div class="atlas-sidebar-tools" role="group" aria-label="本地记录" data-atlas-sidebar-tools>
  <button type="button" data-action="import" aria-label="导入备份" title="导入备份"><Icon name="up-arrow" size="1.12rem" /></button>
  <button type="button" data-action="export" aria-label="导出备份" title="导出备份"><Icon name="download" size="1.12rem" /></button>
</div>
