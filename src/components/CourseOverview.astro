---
import { getCourse } from '../data/courses';
import { chapters as allChapters, getChapters, chapterAnchor, chapterLabel } from '../data/chapters';
import { getCatalog } from '../lib/catalog';
import { kinds } from '../lib/atlas-model';
import { sitePath } from '../lib/paths';
import CourseChapterNav from './CourseChapterNav.astro';
import { getLectures } from '../lib/lectures';
interface Props { courseId: string }
const { courseId } = Astro.props;
const course = getCourse(courseId);
if (!course) throw new Error(`未知课程：${courseId}`);
const chapters = getChapters(courseId);
const nodes = (await getCatalog()).filter(node => node.domain === courseId);
const unassigned = nodes.filter(node => !node.chapterId);
const chapterNodes = (id: string) => nodes.filter(node => node.chapterId === id);
const sections = new Map(await Promise.all(chapters.map(async chapter => [chapter.id, await getLectures(chapter.id)] as const)));
---
<div class="course-overview" data-course-page={courseId}>
  <p class="course-description">{course.description}</p>
  <div class="course-goal"><span>学习方向</span><p>{course.goal}</p></div>
  {chapters.length > 0 ? <>
    <details class="course-mobile-chapters"><summary>本页章节导航</summary><CourseChapterNav courseId={courseId} mobile /></details>
    <div class="course-outline-heading"><h2 id="章节总览">章节总览</h2><span>{chapters.some(chapter => chapter.example) ? '示例目录 · 可调整' : '课程目录'}</span></div>
    {chapters.some(chapter => chapter.example) && <p class="course-outline-note">以下章节用于展示课程结构，并非最终教学大纲。正式目录与知识条目将根据后续提供的材料整理。</p>}
    <div class="chapter-grid">{chapters.map(chapter => <a class="chapter-card" href={chapter.page ? sitePath(chapter.page) : '#' + chapterAnchor(chapter)} data-chapter-card={chapter.page ? undefined : chapterAnchor(chapter)}>
      <div class="chapter-card-meta"><span>{chapterLabel(chapter.order)}</span>{chapter.example && <span>示例</span>}</div>
      <h3>{chapter.title}</h3><p>{chapter.summary}</p>
      <div class="chapter-card-bottom"><span>{chapter.totalSections ? `${chapter.totalSections} 节 · 已收录 ${sections.get(chapter.id)!.length} 节 · ${chapterNodes(chapter.id).length} 个节点` : chapterNodes(chapter.id).length > 0 ? `${chapterNodes(chapter.id).length} 个知识条目` : '查看章节概览'}</span><span aria-hidden="true">↗</span></div>
    </a>)}</div>
    <div class="chapter-sections">{chapters.map(chapter => <section class="course-chapter-section" id={chapterAnchor(chapter)} data-course-chapter tabindex="-1" aria-labelledby={chapterAnchor(chapter) + '-title'}>
      <div class="chapter-section-heading"><span class="chapter-number">{chapterLabel(chapter.order)}</span><div><p class="eyebrow">{chapter.example ? '示例章节 · 可调整' : '章节概览'}</p><h2 id={chapterAnchor(chapter) + '-title'}>{chapter.title}</h2></div><a class="chapter-back-top" href="#章节总览" aria-label="返回章节总览">↑</a></div>
      <p>{chapter.summary}</p><div class="chapter-focus"><span>探索线索</span><p>{chapter.focus}</p></div>
      {chapter.requires.length > 0 && <div class="chapter-prerequisites"><span>{chapter.example ? '建议衔接（示例）' : '先修章节'}</span>{chapter.requires.map(id => { const pre = allChapters.find(item => item.id === id); return pre ? <a href={(pre.courseId === courseId ? '' : sitePath(pre.courseId + '/')) + '#' + chapterAnchor(pre)}>{pre.title} ↗</a> : null; })}</div>}
      {chapter.page ? <div class="course-published-chapter"><ul>{sections.get(chapter.id)!.map(entry=><li><a href={sitePath(entry.id+'/')}>{entry.data.title}<span>{entry.data.lecture!.nodes.length} 个节点 →</span></a></li>)}</ul><a class="atlas-button" href={sitePath(chapter.page)}>进入章节知识库 →</a></div> : chapterNodes(chapter.id).length > 0 ? <ul class="chapter-knowledge-list">{chapterNodes(chapter.id).map(node => <li><a href={node.url}><span>{kinds[node.kind]}</span>{node.title}<span aria-hidden="true">→</span></a></li>)}</ul> : <p class="chapter-content-note">知识条目尚未收录。这里将逐步连接概念、定律、推导与例题。</p>}
    </section>)}</div>
  </> : <section class="course-awaiting" aria-labelledby="课程目录"><p class="eyebrow">COURSE OUTLINE</p><h2 id="课程目录">课程目录待整理</h2><p>课程入口已就绪。正式章节将根据后续提供的大纲与资料组织，当前不预设完整目录。</p><a href={sitePath()}>浏览其他基础课程 →</a></section>}
  {unassigned.length > 0 && <section class="course-unassigned"><h2 id="课程知识条目">课程知识条目</h2><ul>{unassigned.map(node => <li><a href={node.url}>{node.title}</a></li>)}</ul></section>}
  <div class="course-end-link"><span>查找已收录的知识，或整理自己的学习路径。</span><a href={sitePath('library/')}>打开知识库 →</a></div>
</div>
<script>import '../scripts/course-navigation';</script>
