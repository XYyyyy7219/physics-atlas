---
import { orderedCourses } from '../data/courses';
import { sitePath } from '../lib/paths';
import { getChapter } from '../data/chapters';
const { entry } = Astro.locals.starlightRoute;
const courseId = entry.data.course || getChapter(entry.data.chapterPage || entry.data.lecture?.chapter)?.courseId || entry.data.atlas?.domain || orderedCourses.find(course => entry.id.startsWith(course.id + '/'))?.id;
---
<nav class="course-sidebar-nav" aria-label="知识库与课程" data-pagefind-ignore>
  <details class="knowledge-navigation" open>
    <summary>知识库<svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="m6 4 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
    <div class="course-nav-group" role="group" aria-labelledby="course-group-label">
      <p class="course-nav-label" id="course-group-label">普通物理</p>
      <ul class="course-nav-list">{orderedCourses.map(course => <li>
        <a class="course-nav-item" href={sitePath(course.id + '/')} aria-current={course.id === courseId ? (entry.data.course ? 'page' : 'location') : undefined}>{course.title}</a>
      </li>)}</ul>
    </div>
  </details>
  <a class="course-personal-link" href={sitePath('my-lectures/')} aria-current={Astro.url.pathname === sitePath('my-lectures/') ? 'page' : undefined}>我的讲义</a>
</nav>
