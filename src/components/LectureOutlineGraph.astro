---
interface Props {
  title: string;
  groups: { id: string; label: string; order: number; sections: { id: string; label: string; number: string; order: number; url: string }[] }[];
}
const { title, groups } = Astro.props;
const branchColors = ['#446f98', '#33795b', '#895da5', '#b04f67', '#237d87', '#a36337'];
---
<section class="book-graph" data-lecture-graph data-pagefind-ignore aria-labelledby="讲义目录结构">
  <header class="book-section-heading">
    <h2 id="讲义目录结构">讲义目录结构</h2>
    <span>拖动浏览 · 点击小节阅读</span>
  </header>
  <div class="book-graph-frame">
    <div class="book-graph-controls">
      <input type="search" data-graph-search aria-label="检索讲义目录" placeholder="检索节点…" />
      <div class="book-graph-group" role="group" aria-label="目录层级">
        <button type="button" data-graph-mode="chapters" aria-pressed="true">章节</button>
        <button type="button" data-graph-mode="sections" aria-pressed="false">小节</button>
      </div>
      <div class="book-graph-group book-graph-actions" role="group" aria-label="图谱视角">
        <button type="button" data-graph-action="in" aria-label="放大" title="放大">＋</button>
        <button type="button" data-graph-action="out" aria-label="缩小" title="缩小">−</button>
        <button type="button" data-graph-action="reset" aria-label="重置视角" title="重置视角">⛶</button>
        <button type="button" data-graph-action="pause" aria-label="暂停物理模拟" title="暂停物理模拟" aria-pressed="false">Ⅱ</button>
      </div>
    </div>
    <div class="book-graph-stage" data-graph-stage>
      <canvas aria-hidden="true"></canvas>
      <button type="button" class="book-graph-node" data-graph-node="course" data-graph-kind="root" data-graph-label={title}><i></i><span>{title}</span></button>
      {groups.map((group, index) => <>
        <button type="button" class="book-graph-node" data-graph-node={group.id} data-graph-kind="chapter" data-graph-parent="course" data-graph-label={group.label} data-graph-number={`第${group.order}章`} style={`--branch-color:${branchColors[index % branchColors.length]}`}><i></i><span>{group.label}</span></button>
        {group.sections.map(section => <a class="book-graph-node" href={section.url} draggable="false" data-graph-node={section.id} data-graph-kind="section" data-graph-parent={group.id} data-graph-label={section.label} data-graph-number={`${section.number} 第${section.order}节`} style={`--branch-color:${branchColors[index % branchColors.length]}`} hidden><i></i><span>{section.label}</span></a>)}
      </>)}
    </div>
    <p class="book-graph-status" role="status" data-graph-status></p>
  </div>
</section>
<script>import '../scripts/lecture-outline-graph';</script>
