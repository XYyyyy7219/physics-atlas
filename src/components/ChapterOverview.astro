---
import { getChapter, sectionLabel } from '../data/chapters';
import { getLectures } from '../lib/lectures';
import { sitePath } from '../lib/paths';
import ReadingFrame from './ReadingFrame.astro';

interface Props { chapterId: string }
const { chapterId } = Astro.props;
const chapter = getChapter(chapterId)!;
const entries = await getLectures(chapterId);
const nodeIds = entries.flatMap(entry => entry.data.lecture!.nodes.map(node => node.id));
const total = chapter.totalSections || entries.length;
const pending = Array.from({ length: total }, (_, index) => index + 1)
  .filter(order => !entries.some(entry => entry.data.lecture!.order === order));
---
<ReadingFrame>
  <div class="chapter-reading-intro">
    <p>{chapter.summary}</p>
    <p class="chapter-publication">已收录 {entries.length} / {total} 节 · {nodeIds.length} 个知识节点</p>
  </div>
  {entries[0] && <nav class="chapter-actions" aria-label="本章讲义">
    <a class="atlas-button primary" href={sitePath(entries[0].id + '/')} data-resume-chapter={chapterId}>开始阅读</a>
    <button class="atlas-button" type="button" data-action="save-chapter" data-id={chapterId} data-chapter-title={chapter.title} data-chapter-nodes={JSON.stringify(nodeIds)}>加入我的讲义</button>
    <a class="atlas-button" href={sitePath('learning-map/') + '?chapter=' + encodeURIComponent(chapterId)}>本章学习地图</a>
    {chapter.practicePage && <a class="atlas-button" href={sitePath(chapter.practicePage)}>本章练习</a>}
  </nav>}
  <div class="reader-learning-progress" data-progress-ids={JSON.stringify(nodeIds)} data-pagefind-ignore>
    <span data-reader-progress>已掌握 0 / {nodeIds.length} 个知识节点</span>
    <progress max={nodeIds.length || 1} value="0" aria-label="本章知识节点掌握进度"></progress>
  </div>
  <details class="chapter-mobile-outline">
    <summary>本章各节</summary>
    {entries.map(entry => <a href={'#section-' + entry.data.lecture!.order}>{sectionLabel(entry.data.lecture!.order)} {entry.data.title}</a>)}
  </details>
  {entries.map(entry => {
    const lecture = entry.data.lecture!;
    return <section class="lecture-section-panel" id={'section-' + lecture.order} data-course-chapter tabindex="-1" aria-labelledby={'section-heading-' + lecture.order}>
      <header class="lecture-panel-heading">
        <h2 id={'section-heading-' + lecture.order}><span>{sectionLabel(lecture.order)}</span>{entry.data.title}</h2>
        <a href={sitePath(entry.id + '/')}>阅读本节 ↗</a>
      </header>
      <ul class="lecture-node-menu" aria-label={sectionLabel(lecture.order) + '知识节点'}>
        {lecture.nodes.map(node => <li class="lecture-node-row">
          <a class="lecture-node-choice" href={sitePath(entry.id + '/') + '#' + node.id} data-action="show-node" data-id={node.id}>
            <span class:list={['lecture-kind-dot', node.kind]} aria-hidden="true"></span>
            <span>{node.title}</span>
            <small data-node-progress={node.id}>未开始</small>
          </a>
          <button type="button" class="lecture-node-add" data-action="add-to-lecture" data-id={node.id} aria-label={'将' + node.title + '加入我的讲义'}>＋</button>
        </li>)}
      </ul>
    </section>;
  })}
  {pending.length > 0 && <section class="lecture-pending"><h2>待补充小节</h2><div>{pending.map(order => <span>{sectionLabel(order)}</span>)}</div></section>}
</ReadingFrame>
<script>import '../scripts/course-navigation';</script>
